def _blank_span(line, start, end):
    return line[:start] + " " * (end - start) + line[end:]


def mask_markdown(lines, source=False):
    """Return (masked_lines, meta) — masked lines keep original columns."""
    masked = []
    meta = []  # per line: {"code": bool, "heading": bool, "list": bool}
    in_fence = False
    fence_char = ""
    in_yaml = False
    prev_code_or_blank = True
    for idx, raw in enumerate(lines):
        line = raw.rstrip("\n")
        info = {"code": False, "heading": False, "list": False}
        # YAML front-matter (only at the very top of the file)
        if idx == 0 and line.strip() == "---":
            in_yaml = True
            masked.append(" " * len(line)); info["code"] = True
            meta.append(info); continue
        if in_yaml:
            masked.append(" " * len(line)); info["code"] = True
            meta.append(info)
            if line.strip() in ("---", "..."):
                in_yaml = False
            continue
        # Fenced code blocks
        fm = FENCE_RE.match(line)
        if fm:
            marker = fm.group(1)[0]
            if not in_fence:
                in_fence = True; fence_char = marker
            elif marker == fence_char:
                in_fence = False
            masked.append(" " * len(line)); info["code"] = True
            meta.append(info); prev_code_or_blank = True; continue
        if in_fence:
            masked.append(" " * len(line)); info["code"] = True
            meta.append(info); continue
        # Indented code blocks (4-space / tab, after a blank or code line).
        # Not in SOURCE mode: extracted comments keep their column, so an
        # indented comment would read as code and skip every check.
        if not source and (line.startswith("    ") or line.startswith("\t")) \
                and line.strip() and prev_code_or_blank \
                and not LIST_ITEM_RE.match(line):
            masked.append(" " * len(line)); info["code"] = True
            meta.append(info); continue
        # Table delimiter rows
        if "|" in line and "-" in line and TABLE_DELIM_RE.match(line):
            masked.append(" " * len(line)); info["code"] = True
            meta.append(info); prev_code_or_blank = False; continue
        # Inline masks
        out = line
        for rx in (INLINE_CODE_RE, URL_RE, LINK_TARGET_RE, HTML_TAG_RE):
            for m in list(rx.finditer(out)):
                out = _blank_span(out, m.start(), m.end())
        if HEADING_RE.match(line):
            info["heading"] = True
            # strip the leading #'s from prose analysis but keep heading text
            hm = re.match(r"^\s{0,3}(#{1,6})\s", out)
            if hm:
                out = _blank_span(out, hm.start(1), hm.end(1))
        if LIST_ITEM_RE.match(line):
            info["list"] = True
            lm = LIST_ITEM_RE.match(out)
            if lm:
                out = _blank_span(out, 0, lm.end())
        masked.append(out)
        meta.append(info)
        prev_code_or_blank = (line.strip() == "")
    return masked, meta


# ---------------------------------------------------------------------------
# Blocks — contiguous prose with a char -> (line, col) map, so multi-line
# sentences and multi-word phrases still get exact positions.
# ---------------------------------------------------------------------------
class Block:
    __slots__ = ("_chars", "text", "cmap", "list_item", "first_line")

    def __init__(self):
        self._chars = []
        self.text = ""
        self.cmap = []          # per char: (line_idx0, col0)
        self.list_item = False
        self.first_line = 0

    def finish(self):
        self.text = "".join(self._chars)
        self._chars = []


def build_blocks(masked, meta):
    blocks = []
    cur = None
    for idx, mline in enumerate(masked):
        blank = (mline.strip() == "") or meta[idx]["code"]
        starts_new = meta[idx]["heading"] or meta[idx]["list"]
        if blank:
            cur = None
            continue
        if cur is None or starts_new:
            cur = Block()
            cur.list_item = meta[idx]["list"]
            cur.first_line = idx
            blocks.append(cur)
        if cur._chars:
            cur._chars.append(" ")
            cur.cmap.append(cur.cmap[-1])
        cur._chars.extend(mline)
        cur.cmap.extend((idx, col) for col in range(len(mline)))
        if meta[idx]["heading"]:
            cur = None  # a heading is its own block
    for b in blocks:
        b.finish()
    return blocks


# ---------------------------------------------------------------------------
# Sentence splitting (abbreviation- and decimal-aware, no NLP deps)
# ---------------------------------------------------------------------------
_ABBREV = {"e.g", "i.e", "etc", "vs", "cf", "approx", "fig", "no", "dr",
           "mr", "mrs", "ms", "inc", "st", "min", "max", "sec"}


def split_sentences(text):
    sents = []
    start = 0
    i = 0
    n = len(text)
    while i < n:
        c = text[i]
        if c in ".!?":
            j = i
            while i + 1 < n and text[i + 1] in ".!?":
                i += 1
            tok_m = re.search(r"[A-Za-z][\w.]*$", text[max(0, j - 40):j])
            tok = tok_m.group(0).lower().rstrip(".") if tok_m else ""
            is_decimal = (c == "." and j > 0 and text[j - 1].isdigit()
                          and i + 1 < n and text[i + 1].isdigit())
            is_abbrev = c == "." and (tok in _ABBREV
                                      or (len(tok) == 1 and tok.isalpha()))
            if not is_decimal and not is_abbrev \
                    and (i + 1 >= n or text[i + 1].isspace()):
                seg = text[start:i + 1]
                if seg.strip():
                    sents.append((start, i + 1))
                i += 1
                while i < n and text[i].isspace():
                    i += 1
                start = i
                continue
        i += 1
    if start < n and text[start:].strip():
        sents.append((start, n))
    return sents


# ---------------------------------------------------------------------------
# Verb counting — the honest heuristic (no POS tagger, stdlib only):
#   a token counts as a verb if (a) its lowercase form is in the ~300-entry
#   base-form lexicon, or (b) its -s/-es/-ed/-ing stem is in the lexicon, or
#   (c) it ends in -s/-es/-ed/-ing AND directly follows a subject-ish token
#   (pronoun/demonstrative). Nouns that collide with verb base forms inflate
#   the count; gerunds used as nouns do too. Treat the result as ±15%.
# ---------------------------------------------------------------------------
def _stems(low):
    out = set()
    for suf in ("ing", "es", "ed", "s", "d"):
        if low.endswith(suf) and len(low) > len(suf) + 1:
            stem = low[:-len(suf)]
            out.add(stem)
            out.add(stem + "e")          # creat -> create
            if stem.endswith("i"):
                out.add(stem[:-1] + "y")  # tri(ed) -> try
            if len(stem) > 2 and stem[-1] == stem[-2]:
                out.add(stem[:-1])        # stopp -> stop
    return out


def count_verbs(blocks):
    verbs = 0
    for b in blocks:
        prev = ""
        for m in ALPHA_RE.finditer(b.text):
            low = m.group(0).lower().strip("'-’")
            if not low:
                continue
            if low in VERB_LEXICON:
                verbs += 1
            elif any(s in VERB_LEXICON for s in _stems(low)):
                verbs += 1
            elif prev in SUBJECT_ISH and low.endswith(("s", "ed", "ing")):
                verbs += 1
            prev = low
    return verbs


# ---------------------------------------------------------------------------
# Glossary
# ---------------------------------------------------------------------------
def load_glossary(path):
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as fh:
            terms = [t.strip() for t in fh
                     if t.strip() and not t.strip().startswith("#")]
    except OSError as e:
        sys.stderr.write(
            "ste-lint: cannot read glossary %r: %s.\n"
            "Give --glossary a readable newline-separated text file.\n"
            % (path, e.strerror or e))
        sys.exit(2)
    pats = [re.compile(r"\b" + re.escape(t).replace(r"\-", r"[-\s]")
                       + r"\b", re.IGNORECASE) for t in terms]
    return pats


def glossary_spans(block, glossary_pats):
    spans = []
    for rx in glossary_pats:
        for m in rx.finditer(block.text):
            spans.append((m.start(), m.end()))
    return spans


def _overlaps(spans, start, end):
    return any(s < end and start < e for s, e in spans)


# ---------------------------------------------------------------------------
# The checks
# ---------------------------------------------------------------------------
def V(block, pos, category, severity, found, replace, message, lines):
    line0, col0 = block.cmap[min(pos, len(block.cmap) - 1)]
    return {
        "line": line0 + 1, "col": col0 + 1, "category": category,
        "severity": severity, "found": found, "replace": replace,
        "message": message, "text": lines[line0].rstrip("\n"),
    }


def _fmt_score(v) -> str:
    """UNDEFINED (no verb denominator) must not render as a number a reader trusts."""
    return "UNDEFINED(0 verbs)" if v == float("inf") else "%.2f" % v


def check_sentence_length(block, sents, lines):
    out = []
    for (s, e) in sents:
        seg = block.text[s:e]
        words = WORD_RE.findall(seg)
        if not words:
            continue
        # A markdown table CONTENT row is a data record, not a sentence. Its
        # cells are independent fields, so a word count across the whole row
        # is meaningless. Delimiter rows are
        # already masked upstream; this catches the content rows. Other checks
        # still run on cell text, because cell prose can be genuinely sloppy.
        if seg.count("|") >= 2:
            continue
        first = words[0].lower()
        is_instruction = first in IMPERATIVE_STARTERS or \
            (block.list_item and (first in IMPERATIVE_STARTERS
                                  or first in VERB_LEXICON))
        limit = 20 if is_instruction else 25
        kind = "instruction" if is_instruction else "descriptive"
        if len(words) > limit:
            out.append(V(block, s, "sentence-length", "error",
                         "%d words" % len(words),
                         "split into sentences of <= %d words" % limit,
                         "%s sentence has %d words (max %d)"
                         % (kind, len(words), limit), lines))
    return out


def check_deny_list(block, gspans, lines):
    out = []
    text = block.text
    last_end = -1
    for tm in ALPHA_RE.finditer(text):
        if tm.start() < last_end:
            continue  # inside an already-accepted match
        cands = _DENY_TRIGGER.get(tm.group(0).lower())
        if not cands:
            continue
        for key, rx in cands:
            m = rx.match(text, tm.start())
            if not m:
                continue
            if not _overlaps(gspans, m.start(), m.end()):
                repl = DENY[key]
                out.append(V(block, m.start(), "deny-list", "error",
                             m.group(0), repl,
                             "'%s' -> %s" % (key, repl), lines))
            last_end = m.end()
            break
    return out


def check_passive(block, lines):
    out = []
    for m in PASSIVE_RE.finditer(block.text):
        word = m.group(3)
        low = word.lower()
        if low in IRREGULAR_PARTICIPLES or (low.endswith("ed")
                                            and len(low) > 3):
            out.append(V(block, m.start(), "passive-voice", "warn",
                         m.group(0), "rewrite in active voice",
                         "passive construction '%s'" % m.group(0), lines))
    return out


# One action per sentence. A clause starts after a comma, "and", "or" or
# "then". A clause of two or more words is an action when its first word is a
# known verb: the base form in an instruction, or the -s form in a
# description ("loads", "parses").
# STE allows two actions that happen at the same time, so the check fires at
# MULTI_ACTION_MIN actions.
MULTI_ACTION_MIN = 3
_CLAUSE_SPLIT_RE = re.compile(r",\s*(?:and\s+|or\s+|then\s+)?|\s+(?:and|or|then)\s+")


def _clause_action(clause, first_clause):
    words = [w.lower() for w in ALPHA_RE.findall(clause)]
    if first_clause and len(words) > 1 and words[0] in SUBJECT_ISH:
        words = words[1:]
    if len(words) < 2:
        return False  # a one-word clause is a list item: "a spec, prompt, query"
    w = words[0]
    if w in VERB_LEXICON:
        return True
    return w.endswith("s") and any(s in VERB_LEXICON for s in _stems(w)
                                   if not w.endswith(("ss", "us", "is")))


def check_multi_action(block, sents, lines):
    out = []
    for (s, e) in sents:
        seg = block.text[s:e]
        if seg.count("|") >= 2:
            continue
        clauses = _CLAUSE_SPLIT_RE.split(seg)
        actions = sum(1 for i, c in enumerate(clauses)
                      if _clause_action(c, i == 0))
        if actions >= MULTI_ACTION_MIN:
            out.append(V(block, s, "multi-action", "warn",
                         "%d actions" % actions,
                         "write one action in each sentence",
                         "sentence has %d actions" % actions, lines))
    return out


def check_punctuation(block, sents, lines):
    out = []
    for m in re.finditer("—", block.text):
        out.append(V(block, m.start(), "punctuation", "info", "—",
                     "use a period or a comma", "em dash", lines))
    for m in re.finditer(";", block.text):
        out.append(V(block, m.start(), "punctuation", "info", ";",
                     "split into two sentences", "semicolon", lines))
    for (s, e) in sents:
        n_commas = block.text[s:e].count(",")
        if n_commas >= 3:
            out.append(V(block, s, "punctuation", "info",
                         "%d commas" % n_commas,
                         "split into shorter sentences",
                         "sentence has %d commas" % n_commas, lines))
    return out


# ---------------------------------------------------------------------------
# history-comment — SOURCE comments only. A code comment says what the code
# does and why. Dates, past events and people belong in the dev diary or the
# docs, not in shipped code. People to flag: STE_LINT_PEOPLE (comma-separated).  # history-ok: documents the check
# ---------------------------------------------------------------------------
HISTORY_DATE_RE = re.compile(
    r"\b20\d\d-\d\d-\d\d\b|\b(?:jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)[a-z]*\.? "
    r"\d{1,2},? 20\d\d\b", re.I)
HISTORY_PHRASE_RE = re.compile(
    r"\b(?:used to|no longer|previously|originally|back then|at the time|"
    r"post-?mortem|"
    r"was (?:once |previously )?(?:wired|changed|added|removed|broken|fixed|moved|replaced)|"
    r"once (?:fired|billed|cost|broke|ran|made)|turned into|"
    r"(?:we|i) (?:found|saw|learned|measured|discovered))\b|\bmeasured:", re.I)


def _history_people_re():
    names = [n.strip() for n in os.environ.get("STE_LINT_PEOPLE", "Gyasi").split(",") if n.strip()]
    return re.compile(r"\b(?:%s)\b" % "|".join(map(re.escape, names))) if names else None


def check_history(block, lines):
    out = []
    people = _history_people_re()
    for rx, what in ((HISTORY_DATE_RE, "a date"), (HISTORY_PHRASE_RE, "a past event"),
                     (people, "a person")):
        if rx is None:
            continue
        for m in rx.finditer(block.text):
            line0 = block.cmap[min(m.start(), len(block.cmap) - 1)][0]
            if "history-ok" in lines[line0]:
                continue  # a date the code depends on, marked by the author
            out.append(V(block, m.start(), "history-comment", "error", m.group(0),
                         "say what the code does; move the history to the dev diary / docs",
                         "comment names %s ('%s')" % (what, m.group(0)), lines))
    return out


# skill-arg — SKILL.md files only. Claude Code's skill loader replaces `$0`,
# `$1`, ... and `$ARGUMENTS[N]` in a SKILL.md with the invocation's arguments
# (or nothing) before the model reads it, in prose AND in code blocks. A price
# such as `$0.04`, an awk field such as `{print $1}` or a shell `$1` is then
# silently rewritten. Write `0.04 USD`, awk `$(1)`, shell `${1}`. A line that
# uses the substitution on purpose carries the marker `skill-arg-ok`.
# ---------------------------------------------------------------------------
SKILL_ARG_RE = re.compile(r"\$ARGUMENTS\[\d+\]|\$\d+(?!\w)")


def is_skill_file(path):
    return os.path.basename(path) == "SKILL.md"


def check_skill_args(lines):
    out = []
    for i, line in enumerate(lines):
        if "skill-arg-ok" in line:
            continue
        for m in SKILL_ARG_RE.finditer(line):
            out.append({
                "line": i + 1, "col": m.start() + 1, "category": "skill-arg",
                "severity": "error", "found": m.group(0),
                "replace": "price: N USD | awk: $(N) | shell: ${N} | intended: mark skill-arg-ok",
                "message": "the skill loader replaces '%s' with an argument" % m.group(0),
                "text": line.rstrip("\n"),
            })
    return out


# Fact coverage: a rewrite must keep every fact of its source. Style checks
# alone reward a rewrite that says less, so --source compares the rewrite
# with the original. The key terms are numbers, inline code, identifiers
# (snake_case, CamelCase, paths, flags, ALL-CAPS) and negations.
_FACT_CODE_RE = re.compile(r"`([^`\n]+)`")
_FACT_NUM_RE = re.compile(r"(?<![\w.])\d+(?:[.,]\d+)*(?![\w])")
_FACT_IDENT_RE = re.compile(
    r"(?<![\w-])(?:--?[A-Za-z][\w-]*|[A-Za-z_][\w]*(?:[._/][\w]+)+"
    r"|[a-z]+[A-Z]\w*|[A-Z][a-z]+[A-Z]\w*|[A-Z]{2,}\w*)(?![\w])")
_NEGATION_RE = re.compile(r"\b(?:not|never|no|none|cannot|don't|doesn't|"
                          r"isn't|aren't|won't|can't|mustn't)\b", re.I)


def fact_terms(text):
    """Key terms of a text -> {term: first line number (1-based)}."""
    terms = {}
    for n, line in enumerate(text.splitlines(), 1):
        for rx in (_FACT_CODE_RE, _FACT_NUM_RE, _FACT_IDENT_RE):
            for m in rx.finditer(line):
                term = (m.group(1) if rx is _FACT_CODE_RE else m.group(0))
                terms.setdefault(term.strip(), n)
    terms.pop("", None)
    return terms


def check_fact_coverage(source_text, text, min_ratio):
    """Violations for facts the rewrite dropped, plus a coverage summary."""
    out = []
    terms = fact_terms(source_text)
    missing = []
    for term, n in terms.items():
        rx = re.compile(r"(?<![\w])" + re.escape(term) + r"(?![\w])")
        if not rx.search(text):
            missing.append(term)
            out.append({"line": 0, "col": 0, "category": "fact-coverage",
                        "severity": "error", "found": term,
                        "replace": "keep it from source line %d" % n,
                        "message": "'%s' is in the source but not in the "
                                   "rewrite" % term, "text": ""})
    neg_src = len(_NEGATION_RE.findall(source_text))
    neg_out = len(_NEGATION_RE.findall(text))
    if neg_out < neg_src:
        out.append({"line": 0, "col": 0, "category": "fact-coverage",
                    "severity": "error",
                    "found": "%d of %d negations" % (neg_out, neg_src),
                    "replace": "keep every not / never / no",
                    "message": "the rewrite has fewer negations than the "
                               "source", "text": ""})
    src_words = len(WORD_RE.findall(source_text))
    out_words = len(WORD_RE.findall(text))
    ratio = (out_words / src_words) if src_words else 1.0
    if min_ratio is not None and ratio < min_ratio:
        out.append({"line": 0, "col": 0, "category": "fact-coverage",
                    "severity": "error",
                    "found": "length ratio %.2f" % ratio,
                    "replace": "keep at least %.2f of the source length"
                               % min_ratio,
                    "message": "the rewrite has %d words, the source %d"
                               % (out_words, src_words), "text": ""})
    summary = {"terms": len(terms), "missing": missing,
               "negations_source": neg_src, "negations_rewrite": neg_out,
               "words_source": src_words, "words_rewrite": out_words,
               "length_ratio": round(ratio, 2)}
    return out, summary


def check_synonym_rotation(blocks, section_of_line, glossary_pats, lines):
    # (cluster, section) -> member -> first (pos-sorted) location
    seen = {}
    for b in blocks:
        gspans = glossary_spans(b, glossary_pats) if glossary_pats else []
        for m in ALPHA_RE.finditer(b.text):
            hit = _SYN_TOKEN.get(m.group(0).lower())
            if not hit or _overlaps(gspans, m.start(), m.end()):
                continue
            cname, member = hit
            line0, col0 = b.cmap[m.start()]
            sec = section_of_line[line0]
            d = seen.setdefault((cname, sec), {})
            loc = (line0, col0, b, m.start())
            if member not in d or loc[:2] < d[member][:2]:
                d[member] = loc
    out = []
    for (cname, sec), members in seen.items():
        if len(members) < 2:
            continue
        ordered = sorted(members.items(), key=lambda kv: kv[1][:2])
        names = ", ".join("'%s' (line %d)" % (mname, loc[0] + 1)
                          for mname, loc in ordered)
        _, loc = ordered[1]
        line0, col0, b, pos = loc
        out.append(V(b, pos, "synonym-rotation", "warn",
                     " / ".join(m for m, _ in ordered),
                     "pick one name per thing",
                     "synonym rotation in one section: %s "
                     "-- pick one and use it everywhere" % names, lines))
    return out


# ---------------------------------------------------------------------------
# Reporting
# ---------------------------------------------------------------------------
def human_report(args, path_label, violations, counts, stats, punct_detail,
                 gate_result):
    lines = []
    show_punct_detail = bool(args.only_set) and "punctuation" in args.only_set
    for v in violations:
        if v["category"] == "punctuation" and not show_punct_detail:
            continue
        lines.append("%s:%d:%d  %s  %s → %s"
                     % (path_label, v["line"], v["col"], v["category"],
                        v["found"], v["replace"]))
    lines.append("")
    lines.append("Summary")
    lines.append("  words %d  sentences %d  verbs %d "
                 "(verb count is heuristic, ±15%%)"
                 % (stats["words"], stats["sentences"], stats["verbs"]))
    lines.append("  score: %s violations per 100 verbs | "
                 "%.2f per 100 words"
                 % (_fmt_score(stats["per_verbs"]), stats["per_words"]))
    lines.append("  " + " | ".join("%s %d" % (c, counts[c])
                                   for c in CATEGORIES))
    if counts["punctuation"]:
        lines.append("  punctuation (advisory, not scored): %d em dashes, "
                     "%d semicolons, %d comma-heavy sentences"
                     % (punct_detail["em_dash"], punct_detail["semicolon"],
                        punct_detail["comma_heavy"]))
    if counts["skill-arg"]:
        lines.append("  skill-arg: %d loader substitution(s) -> FAIL "
                     "(the skill loader rewrites these; see the lines above)"
                     % counts["skill-arg"])
    if counts["fact-coverage"]:
        lines.append("  fact-coverage: %d fact(s) lost from --source -> FAIL"
                     % counts["fact-coverage"])
    if gate_result is not None:
        lines.append("  gate: score %s %s max %.2f -> %s"
                     % (_fmt_score(stats["per_verbs"]),
                        ">" if not gate_result else "<=",
                        args.max_score,
                        "FAIL" if not gate_result else "pass"))
    return "\n".join(lines)


def main(argv=None):
    ap = argparse.ArgumentParser(
        prog="ste-lint",
        description="STE-style slop linter for technical prose "
                    "(markdown-aware, stdlib only).")
    ap.add_argument("file", help="input file, or '-' for stdin")
    ap.add_argument("--json", action="store_true",
                    help="machine-readable output")
    ap.add_argument("--glossary", metavar="PATH",
                    help="newline-separated technical terms, never flagged")
    ap.add_argument("--max-score", type=float, default=None, metavar="N",
                    help="exit 1 if violations per 100 verbs exceeds N")
    ap.add_argument("--only", metavar="CATEGORIES",
                    help="comma-separated categories to keep: %s. Use "
                         "'sentence-length,synonym-rotation' to run only the "
                         "checks Vale does NOT cover."
                         % ", ".join(CATEGORIES))
    ap.add_argument("--quiet", action="store_true",
                    help="score only, no per-line detail")
    ap.add_argument("--skill", action="store_true",
                    help="run the skill-arg check (on by default for a file "
                         "named SKILL.md; use it for stdin)")
    ap.add_argument("--source", metavar="PATH",
                    help="the original text this file rewrites; fail if a "
                         "number, code term, identifier or negation of the "
                         "source is missing from the rewrite")
    ap.add_argument("--min-ratio", type=float, default=None, metavar="R",
                    help="with --source: fail if the rewrite has fewer than "
                         "R x the source's words (e.g. 0.6)")
    ap.add_argument("--lang", metavar="EXT",
                    help="force source language (e.g. py ts sql sh); "
                         "auto-detected from filename otherwise. "
                         "Pass 'md' or 'txt' to treat stdin as plain text.")
    args = ap.parse_args(argv)
    if args.only:
        args.only_set = {c.strip() for c in args.only.split(",") if c.strip()}
        bad = args.only_set - set(CATEGORIES)
        if bad:
            print("ste-lint: unknown category %s. Valid: %s"
                  % (", ".join(sorted(bad)), ", ".join(CATEGORIES)), file=sys.stderr)
            return 2
    else:
        args.only_set = None

    if args.file == "-":
        text = sys.stdin.read()
        path_label = "<stdin>"
    else:
        try:
            with open(args.file, "r", encoding="utf-8",
                      errors="replace") as fh:
                text = fh.read()
        except OSError as e:
            sys.stderr.write(
                "ste-lint: cannot read %r: %s.\n"
                "Check the path and permissions, or pass '-' to read "
                "stdin.\n" % (args.file, e.strerror or e))
            return 2
        path_label = args.file

    if not text.strip():
        sys.stderr.write(
            "ste-lint: input is empty (0 non-whitespace bytes). "
            "Give it a file with text, or pipe text to 'ste-lint -'.\n")
        return 2

    glossary_pats = load_glossary(args.glossary) if args.glossary else []

    source_text = None
    if args.source:
        try:
            with open(args.source, "r", encoding="utf-8",
                      errors="replace") as fh:
                source_text = fh.read()
        except OSError as e:
            sys.stderr.write("ste-lint: cannot read --source %r: %s.\n"
                             % (args.source, e.strerror or e))
            return 2
    elif args.min_ratio is not None:
        sys.stderr.write("ste-lint: --min-ratio needs --source.\n")
        return 2

    src_lines = text.splitlines()

    # Determine file extension for source-comment extraction.
    if args.lang:
        ext = ('.' + args.lang.lstrip('.')) if args.lang not in ('md', 'txt', 'markdown') else ''
    elif args.file != '-':
        ext = os.path.splitext(args.file)[1]
    else:
        ext = ''

    # For recognised source extensions, extract comment/docstring prose into a
    # parallel line list (code blanked, prose kept at original column positions).
    # src_lines is kept intact for displaying the original text in violation reports.
    if ext.lower() in SOURCE_EXTS:
        analysis_lines = extract_source_prose(src_lines, ext)
    else:
        analysis_lines = src_lines

    masked, meta = mask_markdown(analysis_lines, source=ext.lower() in SOURCE_EXTS)
    blocks = build_blocks(masked, meta)

    # Section map for synonym rotation: markdown headings delimit sections;
    # if the doc has no headings at all, fall back to 20-line windows.
    has_headings = any(m["heading"] for m in meta)
    section_of_line = []
    sec = 0
    for i, m in enumerate(meta):
        if has_headings:
            if m["heading"]:
                sec += 1
            section_of_line.append(sec)
        else:
            section_of_line.append(i // 20)

    violations = []
    punct_detail = {"em_dash": 0, "semicolon": 0, "comma_heavy": 0}
    total_words = 0
    total_sentences = 0

    for b in blocks:
        gspans = glossary_spans(b, glossary_pats) if glossary_pats else []
        sents = split_sentences(b.text)
        total_sentences += len(sents)
        total_words += len(WORD_RE.findall(b.text))
        violations += check_sentence_length(b, sents, src_lines)
        violations += check_deny_list(b, gspans, src_lines)
        violations += check_passive(b, src_lines)
        violations += check_multi_action(b, sents, src_lines)
        if ext.lower() in SOURCE_EXTS:
            violations += check_history(b, src_lines)
        pv = check_punctuation(b, sents, src_lines)
        for v in pv:
            if v["found"] == "—":
                punct_detail["em_dash"] += 1
            elif v["found"] == ";":
                punct_detail["semicolon"] += 1
            else:
                punct_detail["comma_heavy"] += 1
        violations += pv

    violations += check_synonym_rotation(blocks, section_of_line,
                                         glossary_pats, src_lines)
    if args.skill or (args.file != "-" and is_skill_file(args.file)):
        violations += check_skill_args(src_lines)
    coverage = None
    if source_text is not None:
        cv, coverage = check_fact_coverage(source_text, text, args.min_ratio)
        violations += cv

    if args.only_set:
        violations = [v for v in violations if v["category"] in args.only_set]

    violations.sort(key=lambda v: (v["line"], v["col"]))
    counts = {c: 0 for c in CATEGORIES}
    for v in violations:
        counts[v["category"]] += 1
    total = sum(counts.values())

    verbs = count_verbs(blocks)
    # Punctuation is a SYMPTOM, not the disease: em dashes and semicolons are
    # what a banned-word list already removes without touching the slop itself.
    # Counting them in the headline score buries the real signal, since they
    # outnumber every other category on normal prose. They stay in
    # `counts` and in the report, but they do not drive the score or the gate —
    # unless the user asked for punctuation specifically with --only.
    # skill-arg and fact-coverage are correctness errors, not prose quality:
    # they stay out of the score and fail the run on their own (exit 1), with
    # or without --max-score.
    scored = total if (args.only_set == {"punctuation"}) else (
        total - counts["punctuation"] - counts["skill-arg"]
        - counts["fact-coverage"])
    # A zero verb count makes the per-verb score UNDEFINED, not zero: 0.0 would be the
    # best possible score for text that was just flagged, and --max-score would pass it.
    # A broken measurement must never read as a clean result, so it fails the gate.
    if verbs:
        per_verbs = scored * 100.0 / verbs
    elif scored:
        per_verbs = float("inf")          # violations with no denominator → never "clean"
    else:
        per_verbs = 0.0                   # genuinely nothing flagged
    per_words = (scored * 100.0 / total_words) if total_words else 0.0
    stats = {"words": total_words, "sentences": total_sentences,
             "verbs": verbs, "per_verbs": per_verbs, "per_words": per_words}

    gate_result = None
    ok = True
    if args.max_score is not None:
        gate_result = per_verbs <= args.max_score
        ok = gate_result
    if counts["skill-arg"] or counts["fact-coverage"]:
        ok = False

    if args.json:
        payload = {
            "ok": ok,
            "file": path_label,
            # `Infinity` is NOT valid JSON (RFC 8259) — JS JSON.parse throws on it. An
            # undefined per-verb score serialises as null, with an explicit flag so a
            # consumer can tell "undefined" from "absent" and never read it as clean.
            "score_per_100_verbs": (None if per_verbs == float("inf")
                                    else round(per_verbs, 2)),
            "score_per_100_verbs_undefined": per_verbs == float("inf"),
            "score_per_100_words": round(per_words, 2),
            "scored_violations": scored,
            "total_violations": total,
            "verbs": verbs, "words": total_words,
            "sentences": total_sentences,
            "counts": counts,
            "violations": violations,
        }
        if coverage is not None:
            payload["coverage"] = coverage
        print(json.dumps(payload, indent=2))
    elif args.quiet:
        print("%s violations per 100 verbs | %.2f per 100 words "
              "(%d violations, %d verbs heuristic ±15%%, %d words)"
              % (_fmt_score(per_verbs), per_words, total, verbs, total_words))
        if gate_result is not None:
            print("gate: %s (max %.2f)"
                  % ("pass" if gate_result else "FAIL", args.max_score))
    else:
        print(human_report(args, path_label, violations, counts, stats,
                           punct_detail, gate_result))

    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
