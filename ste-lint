def _inflect_forms(w):
    """A verb's common inflected forms (regular rules + small irregulars)."""
    alts = {w}
    if w.endswith("e"):
        alts |= {w + "s", w + "d", w[:-1] + "ing"}
    elif w.endswith("y") and len(w) > 2 and w[-2] not in "aeiou":
        alts |= {w[:-1] + "ies", w[:-1] + "ied", w + "ing"}
    else:
        alts |= {w + "s", w + "ed", w + "ing"}
    alts |= set(_IRREGULAR_INFLECTIONS.get(w, []))
    return alts


def _inflect_word(w):
    """Regex alternation for a verb's common inflected forms."""
    return "(?:" + "|".join(sorted(_inflect_forms(w), key=len,
                                   reverse=True)) + ")"


def _entry_body(key):
    words = key.split(" ")
    parts = []
    for i, w in enumerate(words):
        inflect = (key in VERB_ENTRIES and i == 0)
        if inflect:
            piece = _inflect_word(w)
        else:
            piece = re.escape(w).replace(r"\-", r"[-\s]")
        parts.append(piece)
    return r"\s+".join(parts)


# Token-trigger dispatch: index every entry under its first word's forms so
# the scanner does one dict lookup per token and only runs an anchored regex
# when a token can start an entry. Longest keys registered first, so
# "carry out a test" beats "carry out", "deep dive" beats "dive into".
_DENY_TRIGGER = {}
for _k in sorted(DENY, key=len, reverse=True):
    _rx = re.compile(_entry_body(_k) + r"\b", re.IGNORECASE)
    _first = _k.split(" ")[0]
    _forms = _inflect_forms(_first) if _k in VERB_ENTRIES else {_first}
    if "-" in _first:
        _forms = set(_forms) | {_first.split("-")[0]}  # spaced variant
    for _f in _forms:
        _DENY_TRIGGER.setdefault(_f.lower(), []).append((_k, _rx))

