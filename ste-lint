def _find_comment_start(line, prefix):
    """Index of first `prefix` not preceded by `:` (skips `://` URLs). -1 if absent."""
    start = 0
    plen = len(prefix)
    while True:
        idx = line.find(prefix, start)
        if idx < 0:
            return -1
        if idx == 0 or line[idx - 1] != ':':
            return idx
        start = idx + plen


def extract_source_prose(lines, ext):
    """Return lines with code blanked and comment/docstring prose preserved.

    Code characters are replaced with spaces so column numbers stay valid.
    Unknown or plain-text extensions return the original lines unchanged.
    """
    style = SOURCE_EXTS.get(ext.lower() if ext else '')
    if style is None:
        return lines

    line_prefixes = style['line']
    block_pair    = style.get('block')     # (open_tok, close_tok) or None
    doc_markers   = style.get('doc') or []

    out = []
    in_block = False
    in_doc   = False
    doc_marker = None
    doc_is_data = False

    for raw in lines:
        nl   = '\n' if isinstance(raw, str) and raw.endswith('\n') else ''
        line = raw.rstrip('\n') if isinstance(raw, str) else raw

        # ── inside a multi-line block comment ──────────────────────────────
        if in_block:
            close = block_pair[1]
            idx = line.find(close)
            # strip decorative leading * common in /** … */ JavaDoc blocks
            _strip_star = lambda s: re.sub(
                r'^ {0,3}\*+\s?', lambda m: ' ' * len(m.group()), s)
            if idx >= 0:
                prose = _strip_star(line[:idx])
                out.append((prose if prose.strip() else ' ' * len(line)) + nl)
                in_block = False
            else:
                prose = _strip_star(line)
                out.append((prose if prose.strip() else ' ' * len(line)) + nl)
            continue

        # ── inside a multi-line docstring (or a triple-quoted DATA string) ──
        if in_doc:
            idx = line.find(doc_marker)
            if idx >= 0:
                kept = '' if doc_is_data else line[:idx]
                out.append(kept + ' ' * (len(line) - len(kept)) + nl)
                in_doc = False
            else:
                out.append((' ' * len(line) if doc_is_data else line) + nl)
            continue

        # ── docstring open (Python triple-quoted strings) ───────────────────
        handled = False
        for dm in doc_markers:
            idx = line.find(dm)
            if idx < 0:
                continue
            close_idx = line.find(dm, idx + len(dm))
            # A docstring stands alone on its line (an optional string prefix
            # aside). `X = """...` or `f("""...` is a string value: data, not prose.
            doc_is_data = line[:idx].strip() not in ('', 'r', 'R', 'u', 'U', 'b', 'B', 'f', 'F')
            if doc_is_data:
                out.append(' ' * len(line) + nl)
                if close_idx < 0:
                    in_doc = True
                    doc_marker = dm
                handled = True
                break
            if close_idx >= 0:
                # single-line: """prose"""
                prose = line[idx + len(dm):close_idx]
                out.append(' ' * (idx + len(dm)) + prose
                           + ' ' * (len(line) - close_idx - len(dm)) + nl)
            else:
                out.append(' ' * (idx + len(dm)) + line[idx + len(dm):] + nl)
                in_doc = True
                doc_marker = dm
            handled = True
            break
        if handled:
            continue

        # ── block comment open ──────────────────────────────────────────────
        if block_pair:
            open_tok, close_tok = block_pair
            idx = (_find_comment_start(line, open_tok)
                   if open_tok.startswith('/') else line.find(open_tok))
            if idx >= 0:
                close_idx = line.find(close_tok, idx + len(open_tok))
                if close_idx >= 0:
                    prose = line[idx + len(open_tok):close_idx]
                    out.append(' ' * (idx + len(open_tok)) + prose
                               + ' ' * (len(line) - close_idx - len(close_tok)) + nl)
                else:
                    rest = line[idx + len(open_tok):]
                    # blank opening lines like /** or /* with no real text after
                    if not re.search(r'[A-Za-z0-9]', rest):
                        out.append(' ' * len(line) + nl)
                    else:
                        out.append(' ' * (idx + len(open_tok)) + rest + nl)
                    in_block = True
                continue

        # ── single-line comment ─────────────────────────────────────────────
        found = False
        for prefix in line_prefixes:
            idx = _find_comment_start(line, prefix)
            if idx < 0:
                continue
            after = line[idx + len(prefix):]
            if after.startswith('!'):    # shebang (#!) — skip
                break
            out.append(' ' * (idx + len(prefix)) + after + nl)
            found = True
            break

        if not found:
            out.append(' ' * len(line) + nl)    # pure code — blank it

    return out


